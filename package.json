{
  "name": "tucklane",
  "private": true,
  "version": "0.1.0",
  "description": "A privacy-first downloads organizer for Windows.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "icons": "tauri icon assets/brand/tucklane-icon.svg"
  },
  "dependencies": {
    "@tanstack/react-virtual": "~3.13.12",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-notification": "~2.7.0",
    "clsx": "~2.1.1",
    "lucide-react": "~0.544.0",
    "radix-ui": "~1.4.3",
    "react": "~19.1.1",
    "react-dom": "~19.1.1",
    "tailwind-merge": "~3.3.1",
    "zustand": "~5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "~9.36.0",
    "@tailwindcss/vite": "~4.1.13",
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/jest-dom": "~6.8.0",
    "@testing-library/react": "~16.3.0",
    "@testing-library/user-event": "~14.6.1",
    "@types/node": "~22.18.0",
    "@types/react": "~19.1.13",
    "@types/react-dom": "~19.1.9",
    "@vitejs/plugin-react": "~5.0.3",
    "eslint": "~9.36.0",
    "eslint-plugin-react-hooks": "~5.2.0",
    "globals": "~16.4.0",
    "jsdom": "~27.0.0",
    "prettier": "~3.6.2",
    "tailwindcss": "~4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "~8.72.0",
    "vite": "~7.3.7",
    "vitest": "~4.1.12"
  }
}
